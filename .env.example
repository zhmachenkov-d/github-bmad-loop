# Copy to `.env` and fill locally / on the shared host. Never commit `.env`.
# Names only — no values. Shared-host cutover must not use laptop defaults as prod.
# Compose fails closed if any of these are empty (${VAR:?…} in docker-compose.yml).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Pre-encoded URL for Compose apps (migrate/worker/outbox/gateway). Use host `postgres`.
# Example shape (fill your own): postgresql://USER:PASSWORD@postgres:5432/DB
# Percent-encode special characters in USER/PASSWORD. Host-debug may use 127.0.0.1 instead.
DATABASE_URL=
WORKER_ID=
